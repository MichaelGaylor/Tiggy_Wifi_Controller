		(at 15 17 0)
		(effects (font (size 3 3) (bold yes)) (justify left bottom))
		(uuid "810ea19c-e96f-5227-822b-eb2b7834b43e")
	)
	(text "Four pins of the ESP32 are either the B and C drives (six axes) or the relays and the charge pump (four axes)."
		(exclude_from_sim no)
		(at 15 22 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "3abe500d-8baa-5df7-8512-29bf8482ee43")
	)
	(text "A jumper for each chooses."
