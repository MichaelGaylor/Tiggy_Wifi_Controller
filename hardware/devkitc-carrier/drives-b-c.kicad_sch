	(text "Four links, all set the same way and to match the firmware's terminal layout.  Towards \"6 AXES\" (as drawn, and as"
		(exclude_from_sim no)
		(at 35.56 165.1 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "107e48d0-56d7-5ae7-a703-ef85156c096c")
	)
	(text "a new controller is set): six drives.  Towards \"4 AXES + RELAYS\": four drives, three relays and the charge pump."
		(exclude_from_sim no)
		(at 35.56 168.91 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "484fca7f-839a-5f4c-ac07-4f6eac684a61")
	)
	(text "With six axes the limit switches of B and C go to terminals A and B of the spindle sensor plug."
		(exclude_from_sim no)
		(at 35.56 172.72 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "47ebc018-f671-59e0-b5f0-8f719f624c6f")
	)
	(text "Drives B, C"
