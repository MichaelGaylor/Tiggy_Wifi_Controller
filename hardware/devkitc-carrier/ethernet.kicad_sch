	(text "The firmware has no pin for chip select: it expects the module always selected.  Here Q1 selects it"
		(exclude_from_sim no)
		(at 30.48 132.08 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "bd1c049b-9eb5-58bc-83c8-d954ee8d60a0")
	)
	(text "20 to 80 ms after the ESP32 leaves reset (47 k and 1 u), so that the module's data output cannot hold"
		(exclude_from_sim no)
		(at 30.48 135.89 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "8c867151-d9cc-5580-9008-aad52395217f")
	)
	(text "GPIO46 high while the ESP32 reads it as a start-up option.  D lets the capacitor empty at once on a reset."
		(exclude_from_sim no)
		(at 30.48 139.7 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "0e1e6058-4c71-5a8b-9312-be112b7482a1")
	)
